#!/bin/bash
set -e

# Color definitions
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # (color reset)

APP_DIR="/opt/penterep-tools"
UPGRADE_BACKUP_DIR="/opt/.penterep-tools-upgrade"
PT_VENV_SCRIPT="/usr/lib/penterep-tools/ptvenv"
VENV_ACTIVATE="/opt/penterep-tools/penterep-tools/bin/activate"
REGISTER_TOOLS_SCRIPT="/usr/bin/register-tools"

# LEGACY_0_2_MIGRATION: BEGIN
# preinst hides APP_DIR only for the first upgrade from the legacy 0.2
# package.  Restore it before touching the venv or regenerating launchers.
if [ -e "$UPGRADE_BACKUP_DIR" ]; then
    if [ -e "$APP_DIR" ]; then
        echo -e "${RED}[!] Both $APP_DIR and $UPGRADE_BACKUP_DIR exist; refusing to overwrite either directory.${NC}" >&2
        exit 1
    fi

    echo -e "${NC}[+] Restoring the existing virtual environment...${NC}"
    mv "$UPGRADE_BACKUP_DIR" "$APP_DIR"
fi

# ptvenv used to be shipped below /opt.  It is now package-managed under
# /usr/lib so that the legacy postrm cannot delete a newly unpacked helper.
rm -f "$APP_DIR/helpers/ptvenv"
rmdir --ignore-fail-on-non-empty "$APP_DIR/helpers" 2>/dev/null || true
# LEGACY_0_2_MIGRATION: END

# Get the full Python version
FULL_PYTHON_VERSION=$(python3 --version | awk '{print $2}')

# Extract the major and minor version
if [[ "$FULL_PYTHON_VERSION" =~ ^[0-9]+\.[0-9]+ ]]; then
    PYTHON_VERSION=$(echo "$FULL_PYTHON_VERSION" | cut -d. -f1,2)
else
    echo -e "${RED}[!] Failed to determine Python version.${NC}"
    exit 1
fi

# Run the script for creating the virtual environment
if [ -x "$PT_VENV_SCRIPT" ]; then
    echo -e "${NC}[+] Running script for creating venv:${NC} $PT_VENV_SCRIPT"
    "$PT_VENV_SCRIPT"
    echo -e "${NC}[+] Venv created successfully.${NC}"
else
    echo -e "${RED}[!] Script $PT_VENV_SCRIPT was not found.${NC}"
    exit 1
fi

# Activate the virtual environment
echo -e "${NC}[+] Activating virtual environment...${NC}"
if [ -f "$VENV_ACTIVATE" ]; then
    source "$VENV_ACTIVATE"

    # Upgrade ptmanager because DEB upgrades preserve the existing virtual
    # environment and must not leave an older installed release in place.
    echo -e "${NC}[+] Installing ptmanager...${NC}"
    pip install --quiet --upgrade ptmanager || { echo -e "${RED}Installation failed.${NC}"; exit 1; }
else
    echo -e "${RED}[!] The file to activate the virtual environment was not found.${NC}"
    exit 1
fi


# Call register-tools to register ptmanager and other tools
#echo -e "${NC}[+] Registering tools...${NC}"
"$REGISTER_TOOLS_SCRIPT" || { echo -e "${RED}[!] Registration of tools failed.${NC}"; exit 1; }

echo -e "${ORANGE}[+] Installation successful ${NC}"
echo -e "[+] Run 'ptmanager --tools-install' command to install all penterep tools"
exit 0
