#!/bin/bash
set -e

APP_DIR="/opt/penterep-tools"
UPGRADE_BACKUP_DIR="/opt/.penterep-tools-upgrade"
LOG_DIR="$APP_DIR/scripts"

# LEGACY_0_2_MIGRATION: Backup recovery, legacy launcher detection, and the
# ptlibs comma workaround can be removed when direct upgrades from 0.2 end.
restore_interrupted_upgrade() {
    # If unpacking/configuration aborts after preinst protected the 0.2 venv,
    # put it back so the previously installed tools remain usable.
    if [ -e "$UPGRADE_BACKUP_DIR" ] && [ ! -e "$APP_DIR" ]; then
        mv "$UPGRADE_BACKUP_DIR" "$APP_DIR"
    fi
}

is_managed_launcher() {
    launcher="$1"
    [ -f "$launcher" ] || return 1
    # The VENV_DIR signature identifies launchers created by version 0.2.
    grep -Fq '# Managed by penterep-tools' "$launcher" 2>/dev/null || \
        grep -Fq 'VENV_DIR="/opt/penterep-tools/penterep-tools"' "$launcher" 2>/dev/null
}

remove_recorded_launchers() {
    [ -d "$LOG_DIR" ] || return 0

    for record in "$LOG_DIR"/*; do
        [ -f "$record" ] || continue
        tool="${record##*/}"

        case "$tool" in
            ptlibs,)
                # Compatibility with a malformed evidence name generated by
                # version 0.2.  It is safe to remove only when its content is
                # positively identified as one of our legacy launchers.
                launcher="/usr/local/bin/$tool"
                if is_managed_launcher "$launcher"; then
                    rm -f "$launcher"
                fi
                continue
                ;;
            *[!A-Za-z0-9._+-]*|'')
                echo "[!] Ignoring invalid recorded tool name: $tool" >&2
                continue
                ;;
        esac

        for launcher_dir in /usr/bin /usr/local/bin; do
            launcher="$launcher_dir/$tool"
            if is_managed_launcher "$launcher"; then
                rm -f "$launcher"
            fi
        done
    done
}

case "${1:-}" in
    upgrade)
        # dpkg calls the old package's postrm during every upgrade.  Never
        # remove the venv, installed tools, evidence, or launchers here.
        exit 0
        ;;

    failed-upgrade|abort-install|abort-upgrade)
        restore_interrupted_upgrade
        exit 0
        ;;

    remove|purge|disappear)
        # These actions represent an actual uninstall, not an upgrade.
        # Remove only launchers positively identified as ours before deleting
        # application state and any abandoned transition backup.
        restore_interrupted_upgrade
        remove_recorded_launchers
        rm -rf "$APP_DIR" "$UPGRADE_BACKUP_DIR"
        ;;

    *)
        echo "[!] Unknown postrm action: ${1:-<empty>}" >&2
        ;;
esac

exit 0
